+        const uint8_t j = (vel_window_idx + VEL_FILT_SIZE - i) % VEL_FILT_SIZE;
+        vel_filtered += vel_window[j] * vel_filt_weights[i];
+    }
+    vel_window_idx = (vel_window_idx + 1) % VEL_FILT_SIZE;
+
     // set velocity and acceleration targets and zero position
     guided_pos_target_cm.zero();
