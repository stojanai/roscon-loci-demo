+// recompute the per-bin drift table; runs only when DROP_VMD or BOOM_HGT changed
+void AC_Sprayer::update_drift_constants()
+{
+    const float vmd = _drop_vmd;
+    const float boom = MAX(_boom_height, 0.0f);
+    if (is_equal(vmd, _drift_last_vmd) && is_equal(boom, _drift_last_boom)) {
+        return;
+    }
+    _drift_last_vmd = vmd;
+    _drift_last_boom = boom;
+
+    static const float rho_water = 1000.0f;    // kg/m^3
+    static const float rho_air = 1.225f;       // kg/m^3
+    static const float air_viscosity = 1.8e-5f; // Pa*s
+    static const float drag_cd = 0.6f;         // drag coefficient, large-droplet regime
+
+    for (uint8_t i = 0; i < AC_SPRAYER_DRIFT_NUM_BINS; i++) {
+        const float dia = vmd * 1.0e-6f * drift_bin_dia_factor[i];
+        // Stokes settling for small droplets, drag-limited for large; the slower governs
+        const float v_stokes = (rho_water * GRAVITY_MSS * dia * dia) / (18.0f * air_viscosity);
+        const float v_newton = sqrtf((4.0f * rho_water * GRAVITY_MSS * dia) / (3.0f * rho_air * drag_cd));
+        const float v_term = MAX(MIN(v_stokes, v_newton), 0.05f);
+        _drift_seconds[i] = boom / v_term;
+    }
+}
